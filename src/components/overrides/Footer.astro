---
// Project repo + Discord first - they're the primary entry points and
// repeat in the header social bar. The remaining entries are personal
// channels of the maintainer, kept lower in the grid.
const links = [
  {
    label: 'GitHub',
    href: 'https://github.com/wainejr/acelerado-desafios',
    note: 'acelerado-desafios',
    primary: true,
  },
  { label: 'Discord', href: 'https://discord.gg/NNuzYsNPjV', note: 'comunidade', primary: true },
  { label: 'YouTube', href: 'https://www.youtube.com/@waine_jr', note: '@waine_jr' },
  { label: 'wainejr.com', href: 'https://wainejr.com', note: 'site' },
  { label: 'Instagram', href: 'https://www.instagram.com/waine_jr/', note: '@waine_jr' },
  { label: 'TikTok', href: 'https://www.tiktok.com/@waine_jr', note: '@waine_jr' },
];
---

<footer class="term-footer">
  <div class="term-footer-inner">
    {/* man-page-style header line */}
    <div class="term-footer-manline" aria-hidden="true">
      <span class="term-footer-man-name">acelerado-desafios(1)</span>
      <span class="term-footer-man-rule"></span>
      <span class="term-footer-man-section">[ EOF ]</span>
      <span class="term-footer-man-rule"></span>
      <span class="term-footer-man-source">wainejr.com</span>
    </div>

    <div class="term-footer-prompt">
      <span class="term-footer-sigil">$</span>cat&nbsp;~/.contact<span class="term-footer-blink"
      ></span>
    </div>

    <ul class="term-footer-links">
      {
        links.map((l) => (
          <li class:list={[l.primary && 'is-primary']}>
            <a href={l.href} target="_blank" rel="noopener">
              <span class="term-footer-link-label">{l.label}</span>
              <span class="term-footer-link-note">{l.note}</span>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="term-footer-meta">
      <span>built · static · MIT</span>
      <span class="term-footer-sep" aria-hidden="true">··</span>
      <span>no tracking · no analytics</span>
    </div>
  </div>
</footer>
