---
import Default from '@astrojs/starlight/components/PageTitle.astro';

const route = Astro.locals.starlightRoute;
const data = route.entry.data as any;
const strip = data?.metricStrip;

const slug = (route.slug ?? '') as string;
const isLanding = slug === '' || slug === '/';
const isChallenge = slug.startsWith('desafios/');

function prettyMetric(name?: string | null): string {
  if (!name) return '';
  const map: Record<string, string> = {
    psnr_mean_db: 'PSNR',
    time_ms: 'tempo',
    peak_rss_mb: 'memória',
    disk_write_mb: 'disco',
    binary_size_bytes: 'tam. bin',
    code_size_bytes: 'tam. src',
  };
  return map[name] ?? name;
}
const arrow =
  strip?.direction === 'max' ? '↑' :
  strip?.direction === 'min' ? '↓' : '';
---

{!isLanding && <Default {...Astro.props}><slot /></Default>}

{isChallenge && <span data-challenge-page hidden></span>}

{strip && (
  <dl class="challenge-meta" aria-label="Resumo do desafio">
    {strip.primaryMetric && (
      <div class="cm-item">
        <dt>métrica</dt>
        <dd>
          <span class="cm-v">{prettyMetric(strip.primaryMetric)}</span>
          {arrow && <span class="cm-arrow">{arrow}</span>}
        </dd>
      </div>
    )}
    {strip.validationMinDb != null && (
      <div class="cm-item">
        <dt>validação</dt>
        <dd><span class="cm-v">{strip.validationMinDb} dB+</span></dd>
      </div>
    )}
    {strip.capTimeMs != null && (
      <div class="cm-item">
        <dt>cap tempo</dt>
        <dd><span class="cm-v">{strip.capTimeMs} ms</span></dd>
      </div>
    )}
    {strip.capRssMb != null && (
      <div class="cm-item">
        <dt>cap memória</dt>
        <dd><span class="cm-v">{strip.capRssMb} MB</span></dd>
      </div>
    )}
    {strip.measuredRuns != null && (
      <div class="cm-item">
        <dt>runs</dt>
        <dd><span class="cm-v">{strip.measuredRuns}{strip.warmupRuns ? ` +${strip.warmupRuns} warmup` : ''}</span></dd>
      </div>
    )}
  </dl>
)}
