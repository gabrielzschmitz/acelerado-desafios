---
import Default from '@astrojs/starlight/components/PageTitle.astro';

const route = Astro.locals.starlightRoute;
const data = route.entry.data as any;
const strip = data?.metricStrip;

// In Starlight 0.38+ the route entry's slug lives at `id`, not `slug`.
const id = (route.id ?? route.slug ?? '') as string;
const isLanding = id === '' || id === '/';
const isChallenge = id.startsWith('desafios/');
const isSubmission = id === 'submission';

// Deep-link "source on GitHub" for content pages. Maps the route id to the
// canonical path inside the repo so the reader can jump straight to the
// folder (or file) that backs the page.
const REPO = 'https://github.com/wainejr/acelerado-desafios';
let sourceUrl: string | null = null;
let sourceLabel = '';
if (isSubmission) {
  sourceUrl = `${REPO}/blob/main/SUBMISSION.md`;
  sourceLabel = 'SUBMISSION.md';
} else if (isChallenge) {
  const rel = id.slice('desafios/'.length);
  sourceUrl = `${REPO}/tree/main/${rel}`;
  sourceLabel = `${rel}/`;
}

function prettyMetric(name?: string | null): string {
  if (!name) return '';
  const map: Record<string, string> = {
    psnr_mean_db: 'PSNR',
    time_ms: 'tempo',
    peak_rss_mb: 'memória',
    disk_write_mb: 'disco',
    binary_size_bytes: 'tam. bin',
    code_size_bytes: 'tam. src',
  };
  return map[name] ?? name;
}
const arrow = strip?.direction === 'max' ? '↑' : strip?.direction === 'min' ? '↓' : '';
---

{!isLanding && <Default />}

{isChallenge && <span data-quiet-prose hidden />}

{
  strip && (
    <dl class="challenge-meta" aria-label="Resumo do desafio">
      {strip.primaryMetric && (
        <div class="cm-item">
          <dt>métrica</dt>
          <dd>
            <span class="cm-v">{prettyMetric(strip.primaryMetric)}</span>
            {arrow && <span class="cm-arrow">{arrow}</span>}
          </dd>
        </div>
      )}
      {strip.validationMinDb != null && (
        <div class="cm-item">
          <dt>validação</dt>
          <dd>
            <span class="cm-v">{strip.validationMinDb} dB+</span>
          </dd>
        </div>
      )}
      {strip.capTimeMs != null && (
        <div class="cm-item">
          <dt>cap tempo</dt>
          <dd>
            <span class="cm-v">{strip.capTimeMs} ms</span>
          </dd>
        </div>
      )}
      {strip.capRssMb != null && (
        <div class="cm-item">
          <dt>cap memória</dt>
          <dd>
            <span class="cm-v">{strip.capRssMb} MB</span>
          </dd>
        </div>
      )}
      {strip.measuredRuns != null && (
        <div class="cm-item">
          <dt>runs</dt>
          <dd>
            <span class="cm-v">
              {strip.measuredRuns}
              {strip.warmupRuns ? ` +${strip.warmupRuns} warmup` : ''}
            </span>
          </dd>
        </div>
      )}
    </dl>
  )
}

{
  sourceUrl && (
    <a class="source-link" href={sourceUrl} target="_blank" rel="noopener">
      <span class="source-link-arrow" aria-hidden="true">
        ↗
      </span>
      <span class="source-link-label">source</span>
      <span class="source-link-path">{sourceLabel}</span>
    </a>
  )
}
