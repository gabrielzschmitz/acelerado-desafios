---
import challenges from '../data/challenges.json';

function nextMonthIso(): string {
  const now = new Date();
  const next = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth() + 1, 1));
  return next.toISOString().slice(0, 10);
}

const stats = {
  publicados: challenges.length,
  proximo:    nextMonthIso(),
};
---

<section class="hero-block" data-reveal data-quiet-prose>
  {/* fake terminal "title bar" — left label, right status pill */}
  <header class="hero-titlebar">
    <span class="hero-titlebar-label">~/acelerado-desafios</span>
    <span class="hero-titlebar-pills">
      <span class="hero-pill is-live"><span class="hero-dot"></span>live</span>
      <span class="hero-pill"><span class="hero-pill-k">próximo</span><span class="hero-pill-v">{stats.proximo}</span></span>
    </span>
  </header>

  <div class="hero-body">
    <div class="hero-prompt" data-reveal-item>
      <span class="hero-sigil">$</span><span class="hero-cmd">./desafios --live</span>
    </div>

    <h1 class="hero-title" data-reveal-item>
      acelerado<span class="hero-bracket">[</span>desafios<span class="hero-bracket">]</span>
    </h1>

    <p class="hero-tagline" data-reveal-item>
      Um problema novo todo dia 1º. Qualquer linguagem. Métrica, caps e validação definidos por desafio.<span class="hero-cursor"></span>
    </p>

    <dl class="hero-meta" data-reveal-item>
      <div class="hero-kv">
        <dt class="hero-k">CADÊNCIA</dt>
        <dd class="hero-v">mensal</dd>
      </div>
      <div class="hero-kv">
        <dt class="hero-k">PUBLICADOS</dt>
        <dd class="hero-v">{String(stats.publicados).padStart(3, '0')}</dd>
      </div>
      <div class="hero-kv">
        <dt class="hero-k">SUBMISSÃO</dt>
        <dd class="hero-v">docker + PR</dd>
      </div>
      <div class="hero-kv">
        <dt class="hero-k">REGRAS</dt>
        <dd class="hero-v">por desafio</dd>
      </div>
    </dl>
  </div>

  {/* corner brackets — pure decoration */}
  <span class="hero-corner hero-corner--tl" aria-hidden="true"></span>
  <span class="hero-corner hero-corner--tr" aria-hidden="true"></span>
  <span class="hero-corner hero-corner--bl" aria-hidden="true"></span>
  <span class="hero-corner hero-corner--br" aria-hidden="true"></span>
</section>
