  },
  "validation": {
    "metric": "psnr",
    "ground_truth_dir": "expected/"
  },
  "caps": {
    "time_ms_per_image": 200,
    "peak_rss_mb": 64
  },
  "io": {
    "stdin": "BMP 24-bit grayscale (R=G=B), 512x512",
    "stdout": "BMP 24-bit grayscale (R=G=B), 512x512",
    "writable_filesystem": false
  },
  "bench": {
    "warmup_runs": 1,
    "measured_runs": 5,
    "cpuset": "2,3",
    "cpus": 2,
    "memory": "64m"
  }
