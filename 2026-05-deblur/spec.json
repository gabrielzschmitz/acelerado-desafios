{
  "name": "deblur",
  "title": "Drone amador - desfocando o autofoco ruim",
  "month": "2026-05",
  "primary_metric": "psnr_mean_db",
  "direction": "max",
  "image": {
    "format": "bmp24",
    "width": 512,
    "height": 512,
    "grayscale": true
  },
  "psf": {
