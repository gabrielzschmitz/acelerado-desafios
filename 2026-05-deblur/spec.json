{
  "name": "deblur",
  "title": "arrumando autofoco",
  "month": "2026-05",
  "primary_metric": "psnr_mean_db",
  "direction": "max",
  "image": {
    "format": "bmp24",
    "width": 512,
    "height": 512,
    "grayscale": true
  },
  "psf": {
    "type": "gaussian",
    "sigma_distribution": "uniform",
    "sigma_min": 0.0,
    "sigma_max": 3.5,
    "note": "per-frame sigma drawn i.i.d. from U(sigma_min, sigma_max)"
  },
  "noise": {
    "type": "additive_white_gaussian",
    "sigma_distribution": "uniform",
    "sigma_min": 5.0,
    "sigma_max": 15.0,
    "note": "per-frame stddev drawn i.i.d. from U(sigma_min, sigma_max), pixel scale [0, 255]"
  },
  "validation": {
    "metric": "psnr",
    "ground_truth_dir": "expected/"
  },
  "caps": {
    "time_ms_per_image": 200,
    "peak_rss_mb": 64
  },
  "io": {
    "stdin": "BMP 24-bit grayscale (R=G=B), 512x512",
    "stdout": "BMP 24-bit grayscale (R=G=B), 512x512",
    "writable_filesystem": false
  },
  "bench": {
    "warmup_runs": 1,
    "measured_runs": 5,
    "cpuset": "2,3",
    "cpus": 2,
    "memory": "64m"
  }
}
